# Content source: "fixtures" (default; tests and local development) or "supabase" (preview and production).
CONTENT_SOURCE=fixtures

# Supabase project (Project Settings → API). The publishable key only reads published Content (row-level security).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Shared secret sent by the Supabase database webhook as "Authorization: Bearer <secret>".
REVALIDATE_SECRET=

# Added by hand in Vercel (random, 16+ characters); Vercel Cron then sends it to /api/keep-alive as "Authorization: Bearer <secret>".
CRON_SECRET=
