# Content source: "fixtures" (default; tests and local development) or "supabase" (preview and production).
CONTENT_SOURCE=fixtures

# Supabase project (Project Settings → API). The publishable key only reads published Content (row-level security).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Shared secret sent by the Supabase database webhook as "Authorization: Bearer <secret>".
REVALIDATE_SECRET=

# Added by hand in Vercel (random, 16+ characters); Vercel Cron then sends it to /api/keep-alive as "Authorization: Bearer <secret>".
CRON_SECRET=

# Contact delivery: "log" (default; tests, CI, local without keys) or "live" (stores in Supabase and emails via Resend).
CONTACT_DELIVERY=log

# Server-only Supabase secret key (Project Settings → API Keys → Secret keys). Writes Contact messages; never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Resend API key with sending access limited to tgolab.dev.
RESEND_API_KEY=

# Where Contact message notifications are sent.
CONTACT_NOTIFY_EMAIL=

# Random secret (32+ characters) for hashing visitor IPs; changing it resets the rate limit history.
IP_HASH_SECRET=
